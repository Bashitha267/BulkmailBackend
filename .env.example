PORT=5000
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-secret-in-hostinger-hpanel
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Amazon SES Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=news@acme.example.com
SES_FROM_NAME=Acme Team
SES_SIMULATION_MODE=true
SES_BATCH_SIZE=10
