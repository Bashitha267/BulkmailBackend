{
  "name": "bulkemail-backend",
  "version": "1.0.0",
  "description": "Bulk Mailer API: Express + MySQL + Amazon SES, built for Hostinger Node.js hosting",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/config/runMigrationsCli.js",
    "seed:demo": "node src/seed/seedDemo.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1177.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  }
}
