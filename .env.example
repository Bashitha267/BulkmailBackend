# Copy to .env for local development. On Hostinger, add these as environment
# variables in hPanel instead of uploading a .env file.

NODE_ENV=production
# Hostinger sets PORT itself. Only uncomment for local development.
# PORT=5000

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend address(es), comma-separated, allowed to call the API
CORS_ORIGIN=https://app.example.com
# This API's public address (tracking links, one-click unsubscribe, images)
PUBLIC_BASE_URL=https://api.example.com
# Frontend address (unsubscribe and preference pages)
APP_URL=https://app.example.com

# Owner login. Created on start if it doesn't exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
# true once to reset ADMIN_PASSWORD on an existing account, then remove
ADMIN_RESET_PASSWORD=false

# MySQL (hPanel > Databases). Names usually start with u123456789_
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=8

# Amazon SES (use an IAM user that only has SES permissions)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_CONFIGURATION_SET=
# SNS topic ARN(s) for bounces and complaints, comma-separated.
# The webhook rejects everything until this is set.
SES_SNS_TOPIC_ARNS=
# true = nothing is really sent. Set false when ready to go live.
SES_SIMULATION_MODE=true

# Send queue
WORKER_ENABLED=true
WORKER_TICK_MS=1000

# Optional: folder for images uploaded by the old version
UPLOADS_DIR=
